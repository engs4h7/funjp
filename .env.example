# Copy to .env for local development ONLY (netlify dev). Never commit the real file.
# On Netlify, set these under  Site configuration -> Environment variables.

# Neon connection string (Neon dashboard -> Connect -> pooled connection)
DATABASE_URL=

# Long random string used to sign login cookies. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Optional: require this invite code to create an account (recommended for a public site)
SIGNUP_CODE=

# Optional: set to false to stop anyone creating new accounts (existing users can still log in)
ALLOW_SIGNUP=true

# Local development on plain http only (Safari rejects Secure cookies on http). Never in production.
# ALLOW_INSECURE_COOKIES=true
